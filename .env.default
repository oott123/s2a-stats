# s2astats 配置（环境变量）。mise 从 .env.default + .env 注入。
# 必填项在 .env.default 中留空占位，请在 .env 中覆盖为真实值。

# HTTP 监听地址
S2A_LISTEN_ADDR=:8181

# sub2api Postgres 只读 DSN（必填），例如：
# postgres://ro_user:pass@host:5432/sub2api?sslmode=disable
S2A_SUB2API_DSN=

# 公共只读访问 token（必填）
S2A_PUBLIC_TOKEN=example

# 账期边界时区（仅 monthly-usage 用到）
S2A_BILLING_TIMEZONE=Asia/Singapore

# 公共结果缓存 TTL
S2A_CACHE_TTL=60s

# 单次数据库查询超时
S2A_DB_TIMEOUT=15s
